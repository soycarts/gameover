clips/*
!clips/synthfight.mp4
# Real fights cut from one BattleBots compilation (~25MB total). A git-connected
# Vercel build only sees committed files, so each clip needs its own exception.
!clips/jackpot-copperhead.mp4
!clips/manta-skorpios.mp4
!clips/madcatter-tombstone.mp4
# What each clip was cut from. Tiny, and without it transcribe.py cannot slice the
# source video's captions to this clip's window ever again.
!clips/*.source.json
# Derived from the clips and regenerable, like frames/. The commentary is also a
# spoiler file: it names the winner, so it has no business on the public site.
transcripts/
frames/
# A worktree has no frames/, so symlinking the main checkout's is handy — and a
# symlink is a file, which `frames/` does not match.
frames
# The official Pro League studio cutouts, cached by roster.py --photos. 27 files
# at ~2.2MB each is ~60MB of build-time reference: make_sprites.py reads them and
# commits the derived rows in frontend/sprites.js, which is the only part anyone
# needs. Dotted so serve.py 404s it as well.
bots/.proleague/
.env
__pycache__/
*.pyc
.DS_Store
.venv/
.vercel
.env*
.claude/
comments/.titles-backup/
frontend/_spritecheck.html

# scripts/killswitch.sh parks the live config here while the site is dark
vercel.json.live
